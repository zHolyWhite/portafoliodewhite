---
import Layout from "../layouts/Layout.astro";

const title = "Que onda, soy zHolyWhite";
const letters = title.split("");
---

<Layout>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <h1 class="reveal font-minecraft text-4xl leading-tight sm:text-6xl">
      {letters.map((letter, i) => (
        <span
          class="title-letter"
          style={`animation-delay: ${i * 40}ms`}
        >
          {letter === " " ? "\u00A0" : letter}
        </span>
      ))}
    </h1>

    <p class="reveal text-muted mt-5 max-w-xl text-base sm:text-lg">
      Software Developer, aprendiz en Game Dev y Project Manager
    </p>
  </main>
</Layout>