---
import "../styles/global.css";
import Background from "../components/Background.svelte";
import Intro from "../components/Intro.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "zHolyWhite | Portfolio",
  description = "Khaled's portfolio. Software development, Minecraft projects and game development.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <Background />
    <Intro client:load />

    <slot />

    <script>
      function initializeBuildAnimations() {
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          return;
        }

        const elements = document.querySelectorAll<HTMLElement>(
          "[data-build]:not([data-build-ready])",
        );

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              entry.target.classList.add("is-building");
              observer.unobserve(entry.target);
            }
          },
          {
            threshold: 0,
            rootMargin: "0px 0px -24px 0px",
          },
        );

        elements.forEach((element) => {
          element.dataset.buildReady = "true";
          observer.observe(element);
        });
      }

      initializeBuildAnimations();

      document.addEventListener(
        "astro:page-load",
        initializeBuildAnimations,
      );
    </script>
  </body>
</html>