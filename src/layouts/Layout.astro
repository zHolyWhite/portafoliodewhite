---
import "../styles/global.css";
import Background from "../components/Background.svelte";
import Decorations from "../components/Decorations.astro";
import Intro from "../components/Intro.svelte";
import Window from "../components/Window.astro";
import { sections } from "../data/sections";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "zHolyWhite | Portfolio",
  description = "Khaled's portfolio. Software development, Minecraft projects and game development.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeebf1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <script is:inline>
      document.documentElement.dataset.intro = "playing";
    </script>
  </head>

  <body>
    <Background client:load />
    <Intro client:load />

    <div class="page-shell" id="top">
      <Decorations />

      <div class="desktop">
        <Window title="zHolyWhite - Portfolio">
          <nav class="xp-tabs" aria-label="Sections">
            {
              sections.map((section) => (
                <a class="xp-tab" href={section.href}>
                  {section.label}
                </a>
              ))
            }
          </nav>

          <div class="xp-content">
            <slot />
          </div>
        </Window>
      </div>
    </div>

    <script>
      function initializeBuildAnimations() {
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          return;
        }

        const elements = document.querySelectorAll<HTMLElement>(
          "[data-build]:not([data-build-ready])",
        );

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              entry.target.classList.add("is-building");
              observer.unobserve(entry.target);
            }
          },
          {
            threshold: 0,
            rootMargin: "0px 0px -24px 0px",
          },
        );

        elements.forEach((element) => {
          element.dataset.buildReady = "true";
          observer.observe(element);
        });
      }

      initializeBuildAnimations();

      document.addEventListener(
        "astro:page-load",
        initializeBuildAnimations,
      );
    </script>
  </body>
</html>