---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="xp-window">
  <header class="xp-titlebar">
    <span class="xp-title-icon" aria-hidden="true"></span>
    <span class="xp-title">{title}</span>

    <div class="xp-controls" aria-hidden="true">
      <span class="xp-control">_</span>
      <span class="xp-control">□</span>
      <span class="xp-control xp-control--close">✕</span>
    </div>
  </header>

  <div class="xp-body">
    <slot />
  </div>
</div>